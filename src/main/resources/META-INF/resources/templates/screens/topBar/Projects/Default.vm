<!-- Sequence: 10 -->
<!-- Browse Available Projects -->
<script>
    jq.getJSON(serverRoot +'/data/archive/projects?format=json&accessible=true',function(data){
        var projArray = data.ResultSet.Result;
        var userRole = "user_role_" + data.ResultSet.xdat_user_id;
        for (i=0,j=projArray.length; i<j; i++) {
            // for each project in array, check to see if user has permission to view. If so, then display link.
            var projObj = projArray[i];
            if (projObj[userRole].length > 0) {
                var link = '<li><a href="' + serverRoot + '/data/projects/' + projObj.id + '">' + projObj.name + '</a></li>';
                jq('#mainNavProjects ul').append(link);
            }
        }

        // show project menu when complete
        jq('#mainNavProjects').show();
    });
</script>

