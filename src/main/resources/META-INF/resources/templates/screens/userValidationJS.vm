##modified to prevent values greater than 255 characters.
<script type="text/javascript" src="$content.getURI("scripts/user/validateUsername.js")"></script>
<script type="text/javascript">
    XNAT.app.register = {
        validateForm: function(e){
            // start by removing previous error messages
            $('.errorMsg').remove();

            // create a few shortcuts
            /*
            if(!validateUsername(document.getElementById('xdat:user.login'))){
                return false;
            }
            */

            var validateInput = XNAT.app.register.validateInput;
            var validators = XNAT.app.register.validators;

            // execute the validators on the fields, creating a list of boolean results for each field.
            var validations = [validateInput('xdat:user.login', [{val:validators.nonEmpty, msg: "Please enter a login name"},{val:validators.max255, msg: "Exceeded 255 character limit"},{val:validators.noSpecialChars,msg:"Username must be alphanumeric. No spaces."}]),
                validateInput('xdat:user.primary_password', [{val:validators.nonEmpty, msg: "Password is required"},{val:validators.max255, msg: "Exceeded 255 character limit"}]),
                validateInput('xdat:user.firstname', [{val:validators.nonEmpty, msg: "Please enter your first name"},{val:validators.max255, msg: "Exceeded 255 character limit"}]),
                validateInput('xdat:user.lastname', [{val:validators.nonEmpty, msg:"Please enter your last name"},{val:validators.max255, msg: "Exceeded 255 character limit"}]),
                validateInput('xdat:user.email', [{val:validators.nonEmpty, msg: "Email address is required"},{val:validators.max255, msg: "Exceeded 255 character limit"},
                    {val:validators.isEmail(), msg:"Please enter a valid email address"}])];
            if(YUIDOM.get('xdat:user.password_check')!=null){
                validations.push(validateInput('xdat:user.password_check', [{val:validators.nonEmpty, msg:"Please re-enter your password"}, {val:validators.valuesMatch('xdat:user.primary_password'),msg:"Passwords must match"}]));
            }
            // if any of the validations failed, stop form submission
            for (var i=0; i < validations.length; i++){
                if (!validations[i]){
                    return false;
                }
            }
            return true;
        },
        validateInput: function(inputId, validators){
            var input = document.getElementById(inputId);
            for (var i=0; i < validators.length; i++){
                var validator = validators[i].val;
                var message = validators[i].msg;
                if (!validator(input)){
                    XNAT.app.register.validationError(input,message);
                    return false;
                }
            }

            XNAT.app.register.validationSuccessful(input);
            return true;
        },
        validationError: function(input,msg){
            $(input).parent('p').addClass('error').append('<span class="errorMsg"><span class="icon icon-sm icon-error"></span>'+msg+'</span>');
        },
        validationSuccessful: function(input){
            return;
        },
        /* Collection of validation functions */
        validators: {
            nonEmpty: function(input){
                return input.value.trim().length > 0;
            },
            max255: function(input){
                return input.value.length < 256;
            },
            noSpecialChars: function(input){
                return isAlphaNumeric($(input).val());
            },
            valuesMatch: function(inputIdToCompare){
                var inputToCompare = document.getElementById(inputIdToCompare);
                return function(input) {
                    return inputToCompare.value == input.value;
                }
            },
            isEmail: function(){
                var emailReg = /^([A-Za-z0-9_\-\.])+\@([A-Za-z0-9_\-\.])+\.([A-Za-z]{2,})$/;
                return function(input) {
                    return emailReg.test(input.value);
                }
            },
            regex: function(regex){
                return function(input){
                    return input.value.match(regex)
                }
            }
        }
    };


    function validateName(obj, which, button_id){
        var valid = false;
        if (obj.value!=""){
            if(isAlphaNumeric(obj.value)){
                valid = true;
            }else{
                xmodal.message('User Validation', which+' name cannot contain special characters.  Please modify.');
                obj.focus();
            }
        }
        // check(obj, valid, button_id);
        return valid;
    };

    function validateEmail(obj, button_id){
        var valid = false;
        if (obj.value!=""){
            if(XNAT.app.register.validators.isEmail()(obj)){
                valid = true;
            }else{
                xmodal.message('User Validation', 'Invalid email address.  Please modify.');
                obj.focus();
            }
        }
        // check(obj, valid, button_id);
        return valid;
    };

    function check(obj, valid, button_id){
        if(valid){
            if(obj.appendedImage!=undefined)appendImage(obj,"/images/checkmarkGreen.gif");
            if(button_id!=undefined)document.getElementById(button_id).disabled=false;
        }else{
            appendImage(obj,"/images/checkmarkRed.gif");
            if(button_id!=undefined)document.getElementById(button_id).disabled=true;
        }
    };

</script>
<!-- END xdat-templates/screens/userValidationJS.vm -->
