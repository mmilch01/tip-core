#if($subject)
    #set($part_id = $subject.getStringProperty("ID"))
    <tr>
        <th align="left">$displayManager.getSingularDisplayNameForSubject(): </th>
        <td valign="center">
            <a href="$link.setAction("DisplayItemAction").addPathInfo("search_element","xnat:subjectData").addPathInfo("search_field","xnat:subjectData.ID").addPathInfo("search_value",$part_id).addPathInfo("popup","$!popup").addPathInfo("project","$!project")">#if($project)$turbineUtils.escapeHTML($!subject.getIdentifier($project,false))#else$turbineUtils.escapeHTML($!subject.getId())#end</a>
        </td>
    </tr>
    #if($!subject.getGenderText())
        <tr>
            <th align="left">Gender: </th>
            <td>$turbineUtils.escapeHTML($!subject.getGenderText())</td>
        </tr>
    #end
    #if($subject.getHandedText())
        <tr>
            <th align="left">Handedness: </th>
            <td>$turbineUtils.escapeHTML($!subject.getHandedText())</td>
        </tr>
    #end
    #if($!subject.Cohort)
        <tr>
            <th align="left">Cohort: </th>
            <td>$turbineUtils.escapeHTML($!subject.Cohort)</td>
        </tr>
    #end
    <tr>
        <th align="left">Age: </th>
        <td>$turbineUtils.escapeHTML($!om.getSubjectAge())</td>
    </tr>
    #if($!item.getProperty("dcmPatientBirthDate"))
        <tr>
            <th align="left">DOB:</th>
            <td>$!item.getProperty("dcmPatientBirthDate")</td>
        </tr>
    #end
#else
<tr><td>* $displayManager.getSingularDisplayNameForSubject() data unavailable</td></tr>
#end